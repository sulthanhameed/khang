# ═══════════════════════════════════════════════════════════════
# KHANG FRONTEND — Environment Variables
# ═══════════════════════════════════════════════════════════════
#
# HOW TO USE:
# 1. Copy this file to `.env` in the same folder
# 2. Fill in your real values (below)
# 3. Never commit `.env` to git (already in .gitignore)
#
# ═══════════════════════════════════════════════════════════════

# ─── Backend API URL ────────────────────────────────────────────
# Points to your Express backend (deployed to Render or local)
#
# For LOCAL development (backend running on your machine):
#   VITE_API_URL=http://localhost:5000/api
#
# For PRODUCTION (backend deployed to Render):
#   VITE_API_URL=https://khang-backend.onrender.com/api
#
# If left unset, the app works in offline demo mode.

VITE_API_URL=https://khang-backend.onrender.com/api
